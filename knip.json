{
  "$schema": "https://unpkg.com/knip@6/schema-jsonc.json",
  "workspaces": {
    ".": {
      "entry": ["scripts/*.{ts,js}"],
      "project": ["scripts/**/*.{ts,js}"],
      "ignore": ["--version/**"]
    },
    "apps/web": {
      "entry": [
        "src/app/**/{page,layout,loading,error,not-found,default,template,route,middleware}.{ts,tsx,js,jsx}",
        "next.config.{ts,js}"
      ],
      "project": ["src/**/*.{ts,tsx,js,jsx}"],
      "ignore": ["src/lib/image-sources.ts"],
      "next": true
    },
    "apps/mobile": {
      "entry": ["app/**/*.{ts,tsx}", "expo-router/entry"],
      "project": ["src/**/*.{ts,tsx}", "app/**/*.{ts,tsx}"],
      "ignore": ["src/lib/image-sources.ts"],
      "ignoreDependencies": ["/^expo-/", "/^react-native-/", "nativewind"],
      "metro": {
        "config": []
      }
    },
    "apps/ui-demo": {
      "entry": ["src/main.tsx", "src/routes/**/*.{ts,tsx}", "vite.config.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "vite": true
    },
    // Three SST apps. `sst.config.ts` is loaded by the SST CLI, never imported by any source
    // file, so it is an entry point rather than dead code in all three.
    "apps/sisyphus-admin": {
      "entry": [
        "src/app/**/{page,layout,loading,error,not-found,default,template,route}.{ts,tsx}",
        "sst.config.ts"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "next": true
    },
    "apps/sisyphus-executor": {
      // `build.mjs` bundles `src/main.ts` with esbuild. `src/main.ts` is still the T007 scaffold —
      // it wires the shutdown registry and nothing else — so bootstrap, agent, session, delivery,
      // output, report, caps, skills, supervision and workflows are all built and tested but
      // reachable from no entry point. The per-directory barrels are the app's real surface until
      // `main()` is wired; without them knip reports the whole app as dead code. See the T143
      // notes: this is an unfinished wiring task, not dead code to delete.
      // `stub-agent-main.ts` is spawned as a child process by path, never imported.
      "entry": ["src/main.ts", "src/*/index.ts", "src/agent/stub-agent-main.ts", "build.mjs"],
      "project": ["src/**/*.ts"]
    },
    "apps/sisyphus-control-plane": {
      // `sst.config.ts` declares the Lambda handler `src/main.handler`, but that module does not
      // exist yet — the jobs are written and tested, nothing dispatches them in production. The
      // four barrels are the app's real surface until the handler lands; keeping `src/main.ts`
      // listed makes knip's "no matches" hint the standing reminder that it is missing.
      "entry": ["src/main.ts", "src/*/index.ts"],
      "project": ["src/**/*.ts"]
    },
    // `packages/sisyphus-api` deliberately has no root `src/index.ts` and no root `.` export: the
    // absence of one is what makes FR-005 (the executor cannot reach server code) a build-time
    // fact rather than a convention. Its entries are exactly the five subpaths its `package.json`
    // exposes — keep the two lists in step.
    "packages/sisyphus-api": {
      "entry": [
        "src/server/index.ts",
        "src/client/index.ts",
        "src/contracts/index.ts",
        "src/db/index.ts",
        "src/db/migrations/index.ts",
        "drizzle.config.{ts,js}"
      ],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["drizzle-kit"]
    },
    "packages/*": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"]
    },
    "packages/shared-frontend": {
      "entry": ["src/index.ts"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignore": [
        "src/lib/image-sources.ts",
        "src/lib/image-sources.native.ts",
        "src/lib/image-sources.web.ts"
      ]
    },
    "packages/api": {
      "entry": ["src/index.ts", "drizzle.config.{ts,js}"],
      "project": ["src/**/*.{ts,tsx}"],
      "ignoreDependencies": ["drizzle-kit"]
    },
    "tooling/*": {
      "entry": ["{index,src/index}.{ts,js,mjs}"],
      "project": ["src/**/*.{ts,js,mjs}", "*.{ts,js,mjs}"],
      "includeEntryExports": true
    },
    "tooling/skills": {
      "entry": ["lib/test-helpers.ts", "lib/**/*.test.ts"],
      "project": ["lib/**/*.{ts,js,mjs}", "*.{ts,js,mjs}"]
    }
  },
  "ignore": ["**/assets/images/converted-svg/**", "**/*.d.ts"],
  "ignoreFiles": ["**/scripts/index-images.ts"],
  "ignoreDependencies": [
    "@bluetel-ai/eslint-config-base",
    "@bluetel-ai/eslint-config-react-native",
    "@bluetel-ai/prettier-config",
    "@bluetel-ai/commit-conventions",
    "@bluetel-ai/image-indexer",
    "@bluetel-ai/qlty-diff"
  ]
}
