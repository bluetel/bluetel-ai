# Managed by skills-install (sh skills.sh config set …).
# Per-repo conventions consumed by shared skills. Safe to hand-edit values.
# Only explicitly-set keys are listed; anything absent uses the catalog default.
ticket_prefix={no jira board/no jira tickets use names instead}
branch_pattern=feature/{feature-name-here}
commit_format={feature/feature-name-here}: {description}
staging_branch=staging
base_branch=main
repo_owner=bluetel
repo_name=bluetel-ai
jira_site=bluetel.atlassian.net
