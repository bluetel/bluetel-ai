{
  "$schema": "https://raw.githubusercontent.com/streetsidesoftware/cspell/main/cspell.schema.json",
  "version": "0.2",
  // en-GB alongside en-US: this is a UK codebase and the Sisyphus specs are written in British
  // English throughout (sanitise, normalise, authorisation, behaviour, colour). Listing every
  // British form as a custom word would be a dictionary maintained by hand.
  "language": "en-US,en-GB",
  "words": [
    "sisyphus",
    "Pulumi",
    "deployables",
    "drizzle",
    "trpc",
    "superjson",
    "opennext",
    "nextauth",
    "esbuild",
    "autoprefixer",
    "clsx",
    "zstd",
    "ndjson",
    "atlassian",
    "verdigris",
    "keycap",
    "Archivo",
    "presigner",
    "presigned",
    "upsert",
    "upserts",
    "quiesce",
    "backoff",
    "resumable",
    "readback",
    "unnotifiable",
    "unsanitised",
    "IMDS",
    "citext",
    "unredacted",
    "unsnapshotted",
    // 003's own vocabulary. `unlaunchable` and `disableable` are the words FR-065 and FR-066 use,
    // and the refusals they describe quote them — renaming them here to please a dictionary would
    // put the code and the specification into disagreement over what the rule is called.
    "unlaunchable",
    "disableable",
    // 003 Phase 9's vocabulary. `unresumable` is the word FR-045 is about — a snapshot that cannot
    // be resumed from — and the refusals in `pause-instance.ts` and `snapshot-recovery.ts` say so
    // in the requirement's own terms. `xvda` is the EC2 root device name.
    "unresumable",
    "unrecoverably",
    "unclocked",
    "Quiescing",
    "xvda",
    "unexpressible",
    "unleased",
    "quiesces",
    "issuetype",
    "issuekey",
    "alives",
    "nosniff",
    "refetches",
    "unmodelled",
    "unconstructible",
    "unrepresentable",
    "forgeable",
    "schemeless",
    "heartbeated",
    "heartbeating",
    "refspec",
    "macrotask",
    "ilike",
    "launchable",
    "startable",
    "ungranted",
    "datname",
    "xact",
    "bytewise",
    "braille",
    "keyset",
    "xlarge",
    "pgbouncer",
    "PgBouncer",
    "timestamptz",
    "worktree",
    "worktrees",
    "onnotice",
    "unlisten",
    "pgcrypto",
    "jsonb",
    "tsvector",
    "nativewind",
    "tailwindcss",
    "tseslint",
    "tsconfig",
    "kiro",
    "compileall",
    "delegator",
    "difypkg",
    "dify",
    "pnpm",
    "qlty",
    "monorepo",
    "expo",
    "nextvitals",
    "unres",
    "webp",
    "indexer",
    "unrs",
    "cspell",
    "cspellplugin",
    "tooling",
    "eslintrc",
    "jiti",
    "stylesheet",
    "useref",
    "usecallback",
    "useeffect",
    "usememo",
    "usestate",
    "BTAI",
    "usecontext",
    "nullish",
    "coalescing",
    "parserOptions",
    "tsconfigRootDir",
    "vite",
    "vitest",
    "nextjs",
    "nextconfig",
    "outdir",
    "doesn",
    "isn",
    "won",
    "turso",
    "slugified",
    "slugifies",
    "testtoken",
    "executability",
    "cloudflared",
    "octokit",
    "deferreds",
    "Streamable",
    "qwen",
    "millis",
    "lockfiles",
    "headlessly",
    "Nlcjpw",
    "unwritable",
    "modelcontextprotocol",
    "unpushed",
    "pyproject",
    "Pipfile",
    "pipenv",
    "Dskip",
    "noopener",
    "bluetel",
    "ABCDJK",
    "rockhub",
    "openclaw",
    "maxage",
    "ACMR",
    "sarif",
    "speckit",
    "assertable",
    "libpq",
    // prompt-lint's vocabulary. `contextops` is the pinned external analyser it shells out to and
    // `tiktoken` is that tool's tokenizer, both named verbatim in the exit-6 message and the report
    // header — spelling them differently would make the report describe a tool that does not exist.
    // `uvx` and `pipx` are the two ephemeral-environment routes that resolve it.
    "contextops",
    "tiktoken",
    "uvx",
    "pipx",
    "frontmatter",
    "semver",
    // `baselined` and `inspectable` are the words the spec and the rule catalogue use for
    // the two mechanisms — a finding downgraded by `baseline.json`, and the requirement
    // that the artifact set be readable rather than heuristic. Renaming them to please a
    // dictionary would put the code and the specification into disagreement.
    "baselined",
    "inspectable"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    ".next",
    ".expo",
    "android",
    "ios",
    "*.lock",
    "pnpm-lock.yaml",
    "*.gen.ts"
  ]
}
