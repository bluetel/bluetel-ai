    "unpushed",
    "pyproject",
    "Pipfile",
    "pipenv",
    "Dskip",
    "noopener",
    "bluetel",
    "ABCDJK",
    "rockhub",
    "openclaw",
    "maxage",
    "ACMR",
    "sarif",
    "speckit",
    "assertable",
    "libpq",
    // 005's vocabulary: the linter being migrated to, its type-aware checker, its config file,
    // and the matching formatter the editor uses.
    "oxlint",
    "oxlintrc",
    "oxfmt",
    "oxfmtrc",
    "tsgolint",
    "fixability",
    "unnamespaced",
    // jira-ticket skill vocabulary. `acli` is the Atlassian CLI, `workitem` its noun for an
    // issue, and `customfield` the prefix Jira gives every custom field id.
    "acli",
    "workitem",
    "customfield",
    "libsecret"
  ],
  "ignorePaths": [
    "node_modules",
    "dist",
    ".next",
    ".expo",
    "android",
    "ios",
    "*.lock",
    "pnpm-lock.yaml",
    "*.gen.ts"
  ]
