# ─── Rockhub — Environment Variables ─────────────────────────────────
# Copy this file to .env.local and fill in the values.
# Variables already set in the process environment take precedence.
# Workspace-root .env.local overrides app-level values.

# ─── Required ────────────────────────────────────────────────────────

# GitHub webhook secret for HMAC-SHA256 signature validation
GITHUB_WEBHOOK_SECRET=

# GitHub App ID (numeric)
GITHUB_APP_ID=

# GitHub App private key — raw PEM string OR base64-encoded PEM.
# When the value does not start with "-----BEGIN", it is decoded as base64.
GITHUB_APP_PRIVATE_KEY=

# GitHub App installation ID (numeric)
GITHUB_APP_INSTALLATION_ID=

# GitHub username of the Bot_User used for @-mentions, assignments,
# and review-request matches. Must be a real GitHub user account
# (separate from the GitHub App's bot identity).
BOT_USERNAME=

# Absolute path to the openclaw CLI binary. Validated at startup
# to be an executable file (fs.accessSync with X_OK).
OPENCLAW_CLI_PATH=

# ─── Optional (defaults shown) ───────────────────────────────────────

# HTTP server port
# PORT=3000

# Webhook endpoint path (the only HTTP route Rockhub exposes)
# WEBHOOK_PATH=/webhook

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# CLI subcommand flags passed to openclaw for each invocation.
# The spawner prepends "agent --agent <unique-name>" automatically.
# This value provides the remaining flags after the agent targeting.
# Example: "agent --local --message" means the full command becomes:
#   openclaw agent --agent rockhub-<id> --local --message "/rockhub <payload-path>"
# OPENCLAW_SUBCOMMAND=agent --local --message

# How the JSON envelope is delivered to the openclaw child process:
#   stdin — write JSON to child's stdin then close (default, recommended)
#   argv  — append a single JSON argv argument
#   env   — set ROCKHUB_PAYLOAD_JSON on the child's environment
#   file  — write to a tempfile under OPENCLAW_LOG_DIR/payloads/ and pass path
# OPENCLAW_PAYLOAD_TRANSPORT=stdin

# Directory for per-invocation openclaw stdout/stderr log files.
# Resolved relative to the working directory of the Rockhub process.
# OPENCLAW_LOG_DIR=./logs/openclaw

# ─── Optional Repo Filters ───────────────────────────────────────────

# Comma-separated allowlist of repository full names (e.g., owner/repo1,owner/repo2)
# When set, only Trigger_Mentions from listed repos are accepted.
# ALLOWED_REPOS=

# Comma-separated denylist of repository full names.
# When set, Trigger_Mentions from listed repos are dropped.
# DENIED_REPOS=
