# ─── Kiro GitHub Worker ("Rocky") — Environment Variables ────────────
# Copy this file to .env.local and fill in the values.
# Variables already set in the process environment take precedence.

# ─── Required ────────────────────────────────────────────────────────

# GitHub webhook secret for HMAC signature validation
GITHUB_WEBHOOK_SECRET=

# Kiro API key for headless CLI authentication
KIRO_API_KEY=

# Absolute path to the kiro-cli binary
KIRO_CLI_PATH=

# GitHub username the bot posts as (used for mention detection and loop prevention)
BOT_USERNAME=

# Branch naming pattern for Worker-created PRs (required, no default)
# Supports placeholders: {issue_number}, {slug}, {pr_number}
# e.g., feat/{issue_number}-{slug} or {issue_number}-{slug}
BRANCH_TEMPLATE=

# ─── Authentication (one set required) ───────────────────────────────

# Option A: Personal Access Token
# GITHUB_TOKEN=ghp_...

# Option B: GitHub App (preferred — provides auto-rotating installation tokens)
# GITHUB_APP_ID=12345
# GITHUB_APP_PRIVATE_KEY=<PEM string or base64-encoded PEM>
# GITHUB_APP_INSTALLATION_ID=67890

# ─── Optional (defaults shown) ──────────────────────────────────────

# HTTP server port
# PORT=3000

# Webhook endpoint path
# WEBHOOK_PATH=/webhook

# Comma-separated list of trigger labels
# TRIGGER_LABELS=agent-action

# Kiro CLI execution timeout in milliseconds
# KIRO_TIMEOUT_MS=600000

# Per-repo setup script (rocky.sh) timeout in milliseconds
# SETUP_SCRIPT_TIMEOUT_MS=120000

# Base directory for temporary working directories (default: system temp dir)
# WORKING_DIR_BASE=/tmp

# Log level: debug, info, warn, error
# LOG_LEVEL=info

# ─── Optional Repo Filters ──────────────────────────────────────────

# Comma-separated allowlist of repository full names (e.g., org/repo1,org/repo2)
# ALLOWED_REPOS=

# Comma-separated denylist of repository full names
# DENIED_REPOS=

# ─── Copilot CLI (optional) ─────────────────────────────────────────

# Absolute path to the GitHub Copilot CLI binary (enables Copilot engine)
COPILOT_CLI_PATH=

# Authentication token for the Copilot CLI (required when using Copilot engine)
COPILOT_GITHUB_TOKEN=

# ─── Claude Code CLI (optional) ─────────────────────────────────────

# Absolute path to the Claude Code CLI binary (enables Claude engine)
CLAUDE_CLI_PATH=

# Anthropic API key for the Claude Code CLI (optional).
# Leave unset to use credentials from signing into the CLI on the host
# (`claude login`). When set, it is injected into the executor's environment.
# ANTHROPIC_API_KEY=

# ─── Engine Selection ───────────────────────────────────────────────

# Default CLI engine: "kiro", "copilot", or "claude" (default: kiro)
# When set to "copilot", COPILOT_CLI_PATH is required
# When set to "claude", CLAUDE_CLI_PATH is required
DEFAULT_ENGINE=kiro

# ─── Admin Dashboard (optional) ─────────────────────────────────────

# Bearer token for authenticating Worker API requests from the admin dashboard
# ADMIN_API_TOKEN=

# Shared secret token for admin dashboard login authentication
# ADMIN_DASHBOARD_TOKEN=
