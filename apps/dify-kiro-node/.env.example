# ─── Dify Remote Debugging ───────────────────────────────────────────
# Copy this file to .env and fill in the values from your Dify instance:
# Plugins → Debug Plugin (host/port/key are shown there).
# Then run `python -m main` to attach this plugin to that instance live.

INSTALL_METHOD=remote
REMOTE_INSTALL_HOST=
REMOTE_INSTALL_PORT=5003
REMOTE_INSTALL_KEY=
