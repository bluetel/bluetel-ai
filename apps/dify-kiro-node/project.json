{
  "name": "dify-kiro-node",
  "projectType": "application",
  "targets": {
    "setup": {
      "executor": "nx:run-commands",
      "options": {
        "command": "python3 -m venv .venv && .venv/bin/pip install -q -r requirements.txt",
        "cwd": "apps/dify-kiro-node"
      },
      "inputs": ["{projectRoot}/requirements.txt"],
      "outputs": ["{projectRoot}/.venv"],
      "cache": true
    },
    "build": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/python -m compileall -q core provider tools main.py",
        "cwd": "apps/dify-kiro-node"
      },
      "dependsOn": ["setup"],
      "inputs": ["default"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": ".venv/bin/python -m unittest discover -s core -p \"*_test.py\" -t .",
        "cwd": "apps/dify-kiro-node"
      },
      "dependsOn": ["setup"],
      "inputs": ["default"],
      "cache": true
    },
    "package": {
      "executor": "nx:run-commands",
      "options": {
        "command": "command -v dify >/dev/null 2>&1 && dify plugin package dify-kiro-node || echo 'dify CLI not found — install it from https://github.com/langgenius/dify-plugin-daemon/releases to package the plugin'",
        "cwd": "apps"
      },
      "dependsOn": ["setup"],
      "cache": false
    }
  }
}
