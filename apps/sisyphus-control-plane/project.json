{
  "name": "sisyphus-control-plane",
  "projectType": "application",
  "implicitDependencies": ["sisyphus-infra"],
  "targets": {
    "trigger-deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'sisyphus-control-plane is deployable'"
      },
      "cache": false
    },
    "deploy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Refusing to deploy: pass --configuration=staging or --configuration=production' >&2 && exit 1",
        "cwd": "apps/sisyphus-control-plane"
      },
      "configurations": {
        "production": { "command": "sst deploy --stage production --config sst.config.ts" },
        "staging": { "command": "sst deploy --stage staging --config sst.config.ts" }
      },
      "dependsOn": ["^build"],
      "cache": false
    },
    "bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Refusing to bootstrap: pass --configuration=staging or --configuration=production' >&2 && exit 1",
        "cwd": "apps/sisyphus-control-plane"
      },
      "configurations": {
        "production": {
          "command": "sst deploy --stage production-bootstrap --config sst-bootstrap.config.ts"
        },
        "staging": {
          "command": "sst deploy --stage staging-bootstrap --config sst-bootstrap.config.ts"
        }
      },
      "cache": false
    },
    "destroy": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Refusing to destroy: pass --configuration=staging or --configuration=production' >&2 && exit 1",
        "cwd": "apps/sisyphus-control-plane"
      },
      "configurations": {
        "production": { "command": "sst destroy --stage production --config sst.config.ts" },
        "staging": { "command": "sst destroy --stage staging --config sst.config.ts" }
      },
      "cache": false
    },
    "destroy-bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Refusing to destroy: pass --configuration=staging or --configuration=production' >&2 && exit 1",
        "cwd": "apps/sisyphus-control-plane"
      },
      "configurations": {
        "production": {
          "command": "sst destroy --stage production-bootstrap --config sst-bootstrap.config.ts"
        },
        "staging": {
          "command": "sst destroy --stage staging-bootstrap --config sst-bootstrap.config.ts"
        }
      },
      "cache": false
    },
    "unlock": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Refusing to unlock: pass --configuration=staging or --configuration=production' >&2 && exit 1",
        "cwd": "apps/sisyphus-control-plane"
      },
      "configurations": {
        "production": { "command": "sst unlock --stage production --config sst.config.ts" },
        "staging": { "command": "sst unlock --stage staging --config sst.config.ts" }
      },
      "cache": false
    },
    "unlock-bootstrap": {
      "executor": "nx:run-commands",
      "options": {
        "command": "echo 'Refusing to unlock: pass --configuration=staging or --configuration=production' >&2 && exit 1",
        "cwd": "apps/sisyphus-control-plane"
      },
      "configurations": {
        "production": {
          "command": "sst unlock --stage production-bootstrap --config sst-bootstrap.config.ts"
        },
        "staging": {
          "command": "sst unlock --stage staging-bootstrap --config sst-bootstrap.config.ts"
        }
      },
      "cache": false
    },
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "apps/sisyphus-control-plane"
      },
      "inputs": ["default", "^default", "{projectRoot}/eslint.config.mjs"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit | loose-ts-check",
        "cwd": "apps/sisyphus-control-plane"
      },
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/ignored-error-codes.json",
        "{projectRoot}/loosely-type-checked-files.json"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "apps/sisyphus-control-plane"
      },
      "inputs": ["default", "^default"],
      "cache": true
    }
  }
}
