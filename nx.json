{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "plugins": [
    {
      "plugin": "@nx/eslint/plugin",
      "options": {
        "targetName": "lint-workspace"
      }
    },
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "typecheck": {
          "targetName": "typecheck"
        },
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        }
      }
    }
  ],
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "sharedGlobals": [
      "{workspaceRoot}/tsconfig.base.json",
      "{workspaceRoot}/tsconfig.json",
      "{workspaceRoot}/.env*",
      "{workspaceRoot}/.oxlintrc.json",
      "{workspaceRoot}/tooling/oxlint-config/**/*",
      "{workspaceRoot}/cspell.json"
    ],
    "production": ["default", "!{projectRoot}/**/*.spec.*", "!{projectRoot}/**/*.test.*"]
  },
  "targetDefaults": {
    "build": {
      "dependsOn": ["^build"],
      "cache": true
    },
    "typecheck": {
      "dependsOn": ["^typecheck"],
      "cache": true
    },
    "lint": {
      "cache": true,
      "configurations": {
        "fix": {
          "command": "oxlint --type-aware --fix ."
        }
      }
    },
    "lint-workspace": {
      "cache": true
    },
    "dev": {
      "cache": false
    }
  },
  "analytics": true,
  "nxCloudId": "6a6341734ca4932ec83afcdb"
}
