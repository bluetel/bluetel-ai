{
  "name": "sisyphus-infra",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "packages/sisyphus-infra"
      },
      "inputs": ["default", "^default", "{projectRoot}/eslint.config.mjs"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit | loose-ts-check",
        "cwd": "packages/sisyphus-infra"
      },
      "inputs": [
        "default",
        "^default",
        "{projectRoot}/tsconfig.json",
        "{projectRoot}/ignored-error-codes.json",
        "{projectRoot}/loosely-type-checked-files.json"
      ],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/sisyphus-infra"
      },
      "cache": true
    }
  }
}
