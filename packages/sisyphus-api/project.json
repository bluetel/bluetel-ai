{
  "name": "sisyphus-api",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "eslint .",
        "cwd": "packages/sisyphus-api"
      },
      "inputs": ["default", "^default", "{projectRoot}/eslint.config.mjs"],
      "cache": true
    },
    "typecheck": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsc --noEmit",
        "cwd": "packages/sisyphus-api"
      },
      "inputs": ["default", "^default", "{projectRoot}/tsconfig.json"],
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "packages/sisyphus-api"
      },
      "cache": true
    },
    "db-generate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "drizzle-kit generate",
        "cwd": "packages/sisyphus-api"
      },
      "cache": false
    },
    "migrate": {
      "executor": "nx:run-commands",
      "options": {
        "command": "tsx src/db/migrations/cli.ts",
        "cwd": "packages/sisyphus-api"
      },
      "cache": false
    }
  }
}
