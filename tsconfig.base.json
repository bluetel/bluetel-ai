{
  "compilerOptions": {
    "target": "ES2020",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    // Explicit rather than auto-discovered: TypeScript 7 does not find @types/node
    // from the hoisted root in this pnpm layout. No-op under 5.9.2. See spec 005 Phase 0.
    "types": ["node"]
  }
}
