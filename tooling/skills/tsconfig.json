{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "lib": ["ES2022"],
    "types": ["node"],
    // The jira-ticket catalog scripts are plain .mjs (copied verbatim into target
    // repos, so they get no build step and ship no declarations). allowJs lets the
    // tests import them and have their types inferred; checkJs stays off so the
    // scripts themselves are not held to the TS config's strictness.
    "allowJs": true,
    "checkJs": false
  },
  "include": ["lib"]
}
