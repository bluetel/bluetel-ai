{
  "name": "oxlint-config",
  "projectType": "library",
  "targets": {
    "lint": {
      "executor": "nx:run-commands",
      "options": {
        "command": "oxlint --type-aware .",
        "cwd": "tooling/oxlint-config"
      },
      "cache": true
    },
    "test": {
      "executor": "nx:run-commands",
      "options": {
        "command": "vitest run",
        "cwd": "tooling/oxlint-config"
      },
      "cache": true
    }
  }
}
